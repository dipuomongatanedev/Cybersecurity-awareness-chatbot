<Window x:Class="ProgPart2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cybersecurity Awareness Bot"
        Height="500"
        Width="1100"
        Background="#1E1E1E">

    <Grid Background="#0F172A">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2.3*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="90"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Grid.Column="0"
                Background="#111827"
                BorderBrush="#38BDF8"
                BorderThickness="0,0,0,2">

            <TextBlock Text="CYBERSECURITY AWARENESS BOT"
                       Foreground="#38BDF8"
                       FontSize="24"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontFamily="Segoe UI"/>
        </Border>

        <Border Grid.Row="1"
                Grid.Column="0"
                Margin="15"
                Background="#1E293B"
                CornerRadius="12"
                BorderBrush="#334155"
                BorderThickness="2">

            <Grid>
                <TextBlock Text="Chat Area"
                           Foreground="#94A3B8"
                           FontSize="13"
                           Margin="15,10,0,0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"/>

                <TextBox x:Name="ChatDisplay"
                         Margin="10,35,10,10"
                         Background="Transparent"
                         Foreground="White"
                         FontSize="14"
                         FontFamily="Consolas"
                         IsReadOnly="True"
                         BorderThickness="0"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"/>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Grid.Column="0"
                Margin="15,0,15,15"
                Background="#111827"
                CornerRadius="12"
                BorderBrush="#334155"
                BorderThickness="2">

            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="110"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="UserInput"
                         Grid.Column="0"
                         Height="40"
                         FontSize="14"
                         FontFamily="Segoe UI"
                         Background="#1E293B"
                         Foreground="White"
                         BorderBrush="#475569"
                         BorderThickness="2"
                         Padding="8"
                         VerticalContentAlignment="Center"
                         KeyDown="UserInput_KeyDown"/>

                <Button Grid.Column="1"
                        Content="Send"
                        Margin="10,0,0,0"
                        FontSize="14"
                        FontWeight="Bold"
                        Background="#38BDF8"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="SendButton_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>

        <Border Grid.Column="1"
                Grid.Row="0"
                Grid.RowSpan="3"
                Margin="15"
                Background="#1E293B"
                CornerRadius="12"
                BorderBrush="#334155"
                BorderThickness="2">

            <StackPanel Margin="12">
                <TextBlock Text="Task Assistant"
                           Foreground="#38BDF8"
                           FontSize="18"
                           FontWeight="Bold"
                           Margin="0,0,0,2"/>

                <TextBlock Text="Track your cybersecurity goals:"
                           Foreground="#94A3B8"
                           FontSize="11"
                           Margin="0,0,0,10"/>

                <TextBlock Text="Security Task Action:" Foreground="#E2E8F0" FontSize="11" Margin="0,2,0,2" FontWeight="SemiBold"/>
                <TextBox x:Name="TaskTextBox"
                         Height="30"
                         Margin="0,0,0,8"
                         Padding="4"
                         VerticalContentAlignment="Center"
                         Background="#0F172A"
                         Foreground="White"
                         BorderBrush="#475569"
                         BorderThickness="1"/>

                <TextBlock Text="Target Reminder Date:" Foreground="#E2E8F0" FontSize="11" Margin="0,0,0,2" FontWeight="SemiBold"/>
                <DatePicker x:Name="ReminderDatePicker"
                            Margin="0,0,0,12"
                            Height="28"/>

                <Button Content="➕ Add New Task"
                        Height="32"
                        Margin="0,0,0,12"
                        Background="#10B981"
                        Foreground="White"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="AddTask_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <TextBlock Text="Active Tasks Checklist:" Foreground="#E2E8F0" FontSize="11" Margin="0,0,0,4" FontWeight="SemiBold"/>
                <ListBox x:Name="TaskListBox"
                         Height="160"
                         Margin="0,0,0,12"
                         Background="#0F172A"
                         Foreground="#F8FAFC"
                         BorderBrush="#334155"
                         Padding="4"/>

                <Button Content="✓ Complete / Remove Task"
                        Height="32"
                        Background="#EF4444"
                        Foreground="White"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="RemoveTask_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>